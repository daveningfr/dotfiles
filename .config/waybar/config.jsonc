{
    "layer": "top",
    "modules-left": [
        "clock",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "pulseaudio",
        "custom/media",
        "custom/media-control",
        "cava"
    ],
    "modules-right": [
        "cpu",
        "temperature",
        "network",
        "bluetooth",
        "battery",
        "custom/swaync"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": ""
        },
        "persistent-workspaces": {
            "*": 5 // 5 workspaces by default on every monitor
        }
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a, %d. %b  %H:%M}"
    },
    "battery": {
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰚥",
        "format-full": "{capacity}% 󰁹",
        "events": {
            "on-discharging-critical": "/home/davening/.config/waybar/scripts/battery-notify.sh critical",
            "on-charging-100": "/home/davening/.config/waybar/scripts/battery-notify.sh full",
            "on-charging": "notify-send -u normal 'Power Switch' Charging'"
        },
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip": true,
        "tooltip-format": "Battery: {capacity}%",
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        }
    },
    "custom/media": {
        "exec": "playerctl status >/dev/null 2>&1 && playerctl metadata --format '{{artist}} — {{title}}' 2>/dev/null || echo 'Nothing Playing'",
        "interval": 0.1,
        "format": "󰎆 {}",
        "max-length": 45,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "escape": true,
        "tooltip": true
    },
    "custom/media-control": {
        "exec": "/home/davening/.config/waybar/scripts/media-control.sh",
        "return-type": "json",
        "interval": 1,
        "format": "{}",
        "on-click": "playerctl play-pause",
        "tooltip": true
    },
    "cava": {
        //"cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
        "framerate": 30,
        "autosens": 0,
        "sensitivity": 2,
        "bars": 14,
        "format_silent": "quiet",
        "bar_delimiter": 0,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "reverse": false,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.17,
        "input_delay": 2,
        "format-icons": [
            " ",
            "▁",
            "▂",
            "▃",
            "▄",
            "▅",
            "▆",
            "▇",
            "█"
        ],
        "actions": {
            "on-click-right": "mode"
        }
    },
    "cpu": {
        "format": "󰍛 {usage}%"
    },
    "temperature": {
        "format": " {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": " {temperatureC}°C"
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 disconnected",
        "tooltip-format": "{ifname}\n{ipaddr}"
    },
    "bluetooth": {
        "format": "{icon}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱 {num_connections}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "format-icons": {
            "enabled": "󰂯",
            "disabled": "󰂲",
            "connected": "󰂱"
        },
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}"
    },
    "custom/swaync": {
        "tooltip": true,
        "format": "<span size='12pt'>{icon}</span>",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}

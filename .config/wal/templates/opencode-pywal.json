{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "{background}",
    "panel": "{color0}",
    "element": "{color8}",
    "text": "{foreground}",
    "muted": "{color7}",
    "primary": "{color12}",
    "secondary": "{color4}",
    "accent": "{color13}",
    "success": "{color3}",
    "warning": "{color5}",
    "error": "{color1}"
  },
  "theme": {
    "primary": "primary",
    "secondary": "secondary",
    "accent": "accent",
    "success": "success",
    "warning": "warning",
    "error": "error",
    "info": "secondary",
    "text": "text",
    "textMuted": "muted",
    "background": "bg",
    "backgroundPanel": "panel",
    "backgroundElement": "element",
    "border": "element",
    "borderActive": "primary",
    "borderSubtle": "panel",
    "diffAdded": "success",
    "diffRemoved": "error",
    "diffContext": "muted",
    "diffHunkHeader": "secondary",
    "diffHighlightAdded": "success",
    "diffHighlightRemoved": "error",
    "diffAddedBg": "panel",
    "diffRemovedBg": "panel",
    "diffContextBg": "bg",
    "diffLineNumber": "muted",
    "diffAddedLineNumberBg": "panel",
    "diffRemovedLineNumberBg": "panel",
